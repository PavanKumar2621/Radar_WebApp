        }

        canvas {
            display: block;

            width: 100%;
            height: 100%;
        }

        /* =========================================
           LEGEND
           ========================================= */

        .legend {
            display: flex;

            flex-wrap: wrap;

            gap: 12px;

            margin-top: 14px;

            min-height: 24px;
        }

        .legend-item {
            display: flex;
            align-items: center;

            gap: 7px;

            padding: 5px 9px;

