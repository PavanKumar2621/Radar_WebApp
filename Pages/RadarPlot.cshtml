<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Radar Azimuth Plot</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #0b0f14;
            color: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            padding: 20px;
        }

        /* =========================================
