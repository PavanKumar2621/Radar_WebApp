                {

                    type: "line",

                    data: {

                        labels: [],

                        datasets: [

                            {

                                label: "Velocity (m/s)",

                                data: [],

                                borderColor: "#ff00ff",

                                backgroundColor:
                                    "rgba(255,0,255,0.1)",

