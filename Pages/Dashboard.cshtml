        // ==========================================
        // Update chart
        // ==========================================

        function updateChart(
            chart,
            value
        ) {

            chart.data.labels.push(
                chart.data.labels.length + 1
            );

            chart.data.datasets[0]
                .data
                .push(value);


            // Keep only last 50 points

            if (
                chart.data.labels.length >
                MAX_POINTS
            ) {

                chart.data.labels.shift();

                chart.data.datasets[0]
                    .data
                    .shift();

            }


            chart.update("none");

        }


