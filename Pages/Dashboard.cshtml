@page
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Radar Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background: #111;
            color: white;
        }
        h1 {
            margin-bottom: 20px;
        }
        .dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        .card {
            background: #222;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #444;
        }
        .card-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #00ff00;
        }
        .data-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #333;
        }
        .label {
            font-size: 14px;
            color: #aaa;
        }
        .value {
            font-size: 18px;
            color: #00ff00;
        }
        .status-panel {
            background: #222;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 18px;
        }
        .status-panel div {
            margin: 5px 0;
        }
    </style>
</head>
<body>
    <h1>Radar Dashboard</h1>

    <div class="status-panel">
        <div> SignalR: <span id="connectionStatus"> Connecting... </span> </div>
        <div> Radar: <span id="radarStatus"> Waiting... </span> </div>
    </div>

    <div class="dashboard" id="dashboard"> </div>

    <script src="~/js/lib/signalr.min.js"></script>
    <script src="~/js/signalr.js"></script>
    <script src="~/js/communication.js"></script>
    <script src="~/js/radarData.js"></script>

    <script>

        let lastRadarDataTime = null;


        // ============================================
        // RADAR DATA RECEIVED
        // ============================================

        RadarDataManager.addHandler(function (data) {

            lastRadarDataTime = Date.now();
            document.getElementById( "radarStatus").textContent = "Receiving";

            const trackId = data.trackId;

            // ========================================
            // CREATE CARD IF IT DOES NOT EXIST
            // ========================================

            if (!document.getElementById(`track-${trackId}`)) {

                const dashboard = document.getElementById("dashboard");
                const card = document.createElement("div");
                card.className = "card";
                card.id = `track-${trackId}`;

                card.innerHTML = `
                    <div class="card-title">Track ${trackId}</div>

                    <div class="data-row">
                        <span class="label">Azimuth</span>
                        <span class="value" id="azimuth-${trackId}">--</span>
                    </div>

                    <div class="data-row">
                        <span class="label">Elevation</span>
                        <span class="value" id="elevation-${trackId}">--</span>
                    </div>

                    <div class="data-row">
                        <span class="label">Range</span>
                        <span class="value" id="range-${trackId}">--</span>
                    </div>

                    <div class="data-row">
                        <span class="label">Velocity</span>
                        <span class="value" id="velocity-${trackId}">--</span>
                    </div>

                    <div class="data-row">
                        <span class="label">SNR</span>
                        <span class="value" id="snr-${trackId}">--</span>
                    </div>
                `;

                dashboard.appendChild(card);
                console.log(`Created card for Track ${trackId}`);
            }

            // ========================================
            // UPDATE CARD VALUES
            // ========================================

            document.getElementById(`azimuth-${trackId}`).textContent = data.azimuth != null ? data.azimuth.toFixed(2) + "°" : "--";
            document.getElementById(`elevation-${trackId}`).textContent = data.elevation != null ? data.elevation.toFixed(2) + "°" : "--";
            document.getElementById(`range-${trackId}`).textContent = data.range != null ? data.range.toFixed(2) + " m" : "--";
            document.getElementById(`velocity-${trackId}`).textContent = data.velocity != null ? data.velocity.toFixed(2) + " m/s" : "--";
            document.getElementById(`snr-${trackId}`).textContent = data.snr != null ? data.snr.toFixed(2) + " dB" : "--";
        });


        // ============================================
        // TRACK REMOVED
        // ============================================

        RadarDataManager.addRemoveHandler(function (trackId) {
            const card = document.getElementById(`track-${trackId}`);
            if (card) {
                card.remove();
                console.log(`Dashboard card removed for Track ${trackId}`);
            }
        });

        // ============================================
        // RADAR NO DATA DETECTION
        // ============================================

        setInterval(function () {
            if (lastRadarDataTime !== null && Date.now() - lastRadarDataTime > 3000) {
                document.getElementById("radarStatus").textContent = "No Data";
            }
        }, 1000);


        // ============================================
        // SIGNALR CONNECTION CLOSED
        // ============================================

        connection.onclose(function () {
            document.getElementById("connectionStatus").textContent = "Disconnected";
            document.getElementById("radarStatus").textContent = "No Connection";
        });

    </script>

</body>
</html>