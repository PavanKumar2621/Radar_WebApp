                            data: [],
                            borderColor: "#00ffff",
                            backgroundColor: "rgba(0,255,255,0.1)",
                            borderWidth: 2,
                            pointRadius: 2,
                            tension: 0.2
                        }
                    ]
                },
                options: getChartOptions("Degrees")
            }
        );

        // ==========================================
        // Create RANGE chart
        // ==========================================

        const rangeChart = new Chart(document.getElementById("rangeChart"),

                {

                    type: "line",

                    data: {

                        labels: [],

                        datasets: [

                            {

                                label: "Range (m)",

                                data: [],

                                borderColor: "#ffff00",

                                backgroundColor:
                                    "rgba(255,255,0,0.1)",

                                borderWidth: 2,

                                pointRadius: 2,

                                tension: 0.2

                            }

                        ]

                    },

                    options:
                        getChartOptions("Meters")

                }

            );


        // ==========================================
        // Create VELOCITY chart
