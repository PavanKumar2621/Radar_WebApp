@page
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Radar Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background: #111;
            color: white;
        }
        h1 {
            margin-bottom: 20px;
        }
        .dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        .card {
            background: #222;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #444;
        }
        .label {
            font-size: 14px;
            color: #aaa;
        }
        .value {
            font-size: 25px;
            margin-top: 10px;
            color: #00ff00;
            /* font-weight: bold; */
        }
        .status-panel {
            background: #222;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 18px;
        }

        .status-panel div {
            margin: 5px 0;
        }
    </style>
</head>
<body>
    <h1>Radar Dashboard</h1>

    <div class="status-panel">
        <div> SignalR: <span id="connectionStatus"> Connecting... </span> </div>
        <div> Radar: <span id="radarStatus"> Waiting... </span> </div>
    </div>

    <div class="dashboard">

        <div class="card">
            <div class="label"> Track ID </div>
            <div class="value" id="trackId"> -- </div>
        </div>

        <div class="card">
            <div class="label"> Azimuth </div>
            <div class="value" id="azimuth"> -- </div>
        </div>

        <div class="card">
            <div class="label"> Elevation </div>
            <div class="value" id="elevation"> -- </div>
        </div>

        <div class="card">
            <div class="label"> Range </div>
            <div class="value" id="range"> -- </div>
        </div>

        <div class="card">
            <div class="label"> Velocity </div>
            <div class="value" id="velocity"> -- </div>
        </div>

        <div class="card">
            <div class="label"> SNR </div>
            <div class="value" id="snr"> -- </div>
        </div>

    </div>

    <script src="~/js/lib/signalr.min.js"></script>
    <script src="~/js/signalr.js"></script>
    <script src="~/js/communication.js"></script>

    <script>

        let lastRadarDataTime = null;

        connection.on("ReceiveRadarData", function (message) {
                lastRadarDataTime = Date.now();
                // console.log("Radar data received:", message);
                const data = message.data;
                // console.log("Radar data:", data.trackId, data.azimuth, data.elevation, data.range, data.velocity, data.snr);
                document.getElementById("radarStatus").textContent = "Receiving";
                document.getElementById("trackId").textContent = data.trackId ?? "--";
                document.getElementById("azimuth").textContent = data.azimuth != null ? data.azimuth + "°" : "--";
                document.getElementById("elevation").textContent = data.elevation != null ? data.elevation + "°" : "--"; 
                document.getElementById("range").textContent = data.range != null ? data.range + " m" : "--";
                document.getElementById("velocity").textContent = data.velocity != null ? data.velocity + " m/s" : "--";
                document.getElementById("snr").textContent = data.snr != null ? data.snr + " dB" : "--";
            }
        );

        // Start radar requests ONLY when Dashboard is opened
        const radarTimer = setInterval(requestRadarData, 1000);
        
        setInterval(function () {
            if (lastRadarDataTime !== null && Date.now() - lastRadarDataTime > 3000) {
                document.getElementById("radarStatus").textContent = "No Data";
            }
        }, 1000);

    </script>
</body>
</html>


